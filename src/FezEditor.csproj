<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>FEZEditor</Title>
    <Authors>zerocker, FEZModding community</Authors>
    <SplashAuthors>Krzyhau</SplashAuthors>
    <Description>A modding editor for FEZ</Description>
    <Version>2026.07</Version>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">..\assets\Icon.ico</ApplicationIcon>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\lib\FNA\FNA.Core.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SplashAuthors</_Parameter1>
      <_Parameter2>$(SplashAuthors)</_Parameter2>
    </AssemblyAttribute>
    <PackageReference Include="FEZRepacker.Core" Version="1.3.1" />
    <PackageReference Include="GitInfo" Version="3.6.0" PrivateAssets="all" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" ExcludeAssets="native" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="VorbisPizza" Version="1.4.2" />
  </ItemGroup>

  <Import Project="..\build\BundleContent.targets"/>
  <Import Project="..\build\CopyFNALibs.targets"/>

</Project>
